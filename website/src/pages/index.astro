---
import "../styles/global.css";

const title = "RMDex — RV's Mix Deck";
const description = "Send exactly the audio you want from your gaming PC to your streaming PC.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rmdex.rishvan.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://rmdex.rishvan.com/og-image.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://rmdex.rishvan.com/og-image.jpg" />
  </head>
  <body class="bg-white font-sans text-ink antialiased">
    <canvas
      id="particle-field"
      class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
      aria-hidden="true"
    ></canvas>
    <script>
      const canvas = document.getElementById("particle-field");
      const ctx = canvas?.getContext("2d") ?? null;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (canvas && ctx && !reduceMotion) {
        const colors = ["#7c93ff", "#4c6ef5", "#3b5bfc"];
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        let width = 0;
        let height = 0;
        let particles = [];

        function resize() {
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width * dpr;
          canvas.height = height * dpr;
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function seed() {
          const count = Math.min(32, Math.max(14, Math.floor((width * height) / 42000)));
          particles = Array.from({ length: count }, () => {
            const isTriangle = Math.random() < 0.3;
            return {
              x: Math.random() * width,
              y: Math.random() * height,
              vx: (Math.random() - 0.5) * 0.18,
              vy: (Math.random() - 0.5) * 0.18,
              r: isTriangle ? 7 + Math.random() * 9 : 1.5 + Math.random() * 2.5,
              color: colors[Math.floor(Math.random() * colors.length)],
              kind: isTriangle ? "tri" : "dot",
              rotation: Math.random() * Math.PI * 2,
              vr: (Math.random() - 0.5) * 0.012,
            };
          });
        }

        function drawTriangle(p) {
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rotation);
          ctx.beginPath();
          for (let i = 0; i < 3; i++) {
            const angle = ((Math.PI * 2) / 3) * i - Math.PI / 2;
            const x = Math.cos(angle) * p.r;
            const y = Math.sin(angle) * p.r;
            if (i === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.closePath();
          ctx.strokeStyle = p.color;
          ctx.globalAlpha = 0.22;
          ctx.lineWidth = 1;
          ctx.stroke();
          ctx.restore();
        }

        function tick() {
          ctx.clearRect(0, 0, width, height);
          for (const p of particles) {
            p.x += p.vx;
            p.y += p.vy;
            p.rotation += p.vr;
            if (p.x < -20) p.x = width + 20;
            if (p.x > width + 20) p.x = -20;
            if (p.y < -20) p.y = height + 20;
            if (p.y > height + 20) p.y = -20;

            if (p.kind === "dot") {
              ctx.beginPath();
              ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
              ctx.fillStyle = p.color;
              ctx.globalAlpha = 0.32;
              ctx.fill();
            } else {
              drawTriangle(p);
            }
          }
          requestAnimationFrame(tick);
        }

        resize();
        seed();
        tick();

        let resizeTimer;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            resize();
            seed();
          }, 150);
        });
      }
    </script>

    <header class="sticky top-0 z-50 border-b border-line bg-white/80 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="#" class="flex items-center gap-2 sm:gap-2.5">
          <img src="/logo.png" alt="RMDex logo" class="h-7 w-7 rounded-xl sm:h-8 sm:w-8" />
          <span class="text-base font-bold text-ink sm:text-lg">RMDex</span>
        </a>
        <div class="flex items-center gap-3 sm:gap-4">
          <a
            href="https://github.com/Rishvan/RMDex"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-ink-muted transition hover:text-ink"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
              <path
                d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.17.69-3.84-1.34-3.84-1.34-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.33.95.1-.74.4-1.25.73-1.54-2.53-.29-5.19-1.27-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.67 5.33-5.21 5.62.41.35.77 1.04.77 2.1 0 1.52-.01 2.74-.01 3.11 0 .3.2.66.79.55 4.52-1.51 7.77-5.76 7.77-10.78C23.02 5.24 18.27.5 12 .5Z"
              ></path>
            </svg>
          </a>
          <a
            href="#download"
            class="rounded-full bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-brand-600/30 transition hover:bg-brand-700 sm:px-5"
            >Download</a
          >
        </div>
      </div>
    </header>

    <main>
      <section class="relative px-6 pt-16 pb-20 sm:pt-20">
        <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 overflow-x-hidden lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
          <div>
            <span class="inline-flex items-center rounded-full bg-brand-600/10 px-4 py-1.5 text-xs font-semibold text-brand-700"
              >Free &amp; open source · Windows 10 2004+</span
            >
            <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl" style="text-wrap: balance;">
              RV's <span class="text-brand-600">Mix Deck</span> for streamers
            </h1>
            <p class="mt-5 max-w-md text-lg text-ink-muted">
              Send exactly the audio you want from your gaming PC to your streaming PC.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="https://apps.microsoft.com/detail/9n8qxcglxcqw?hl=en-US&gl=AE"
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/30 transition hover:bg-brand-700"
                >Get it from Microsoft Store</a
              >
              <a
                href="https://github.com/Rishvan/RMDex"
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-line px-6 py-3.5 text-sm font-semibold text-ink transition hover:border-ink/30 hover:bg-surface"
                >View source</a
              >
            </div>
          </div>
          <div class="min-w-0">
            <svg
              viewBox="0 -28 714 366"
              width="714"
              height="366"
              class="h-auto w-full max-w-full font-sans"
              role="img"
              aria-label="Diagram: on the Gaming PC, Game, Discord, Music, and Mic flow into RMDex. On the Streaming PC, a Capture Card receives that mixed output and passes it to Stream Apps. Apps occasionally toggle on and off to show live per-app capture."
            >
              <defs>
                <linearGradient id="flowGradient" gradientUnits="userSpaceOnUse" x1="20" y1="0" x2="685" y2="0">
                  <stop offset="0%" stop-color="#7c93ff"></stop>
                  <stop offset="100%" stop-color="#3b5bfc"></stop>
                </linearGradient>
                <radialGradient id="hubHalo">
                  <stop offset="0%" stop-color="#4c6ef5" stop-opacity="0.55"></stop>
                  <stop offset="100%" stop-color="#4c6ef5" stop-opacity="0"></stop>
                </radialGradient>
              </defs>

              <rect x="8" y="8" width="341" height="322" rx="18" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="5 5"></rect>
              <text x="178" y="-10" text-anchor="middle" class="fill-ink-muted text-[11px] font-bold tracking-wide">GAMING PC</text>

              <rect x="541" y="8" width="158" height="322" rx="18" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="5 5"></rect>
              <text x="620" y="-10" text-anchor="middle" class="fill-ink-muted text-[11px] font-bold tracking-wide">STREAMING PC</text>

              <text x="445" y="-10" text-anchor="middle" class="fill-ink-muted text-[10px] font-semibold tracking-wide">USB / HDMI BRIDGE</text>

              <circle cx="270" cy="170" r="78" fill="url(#hubHalo)" class="hub-halo"></circle>

              <path d="M160,50 C183,50 183,170 205,170" data-line="game" class="flow-line" stroke="url(#flowGradient)" stroke-width="2" fill="none"></path>
              <circle r="4" data-line="game" class="flow-dot fill-brand-500" style="offset-path: path('M160,50 C183,50 183,170 205,170');"></circle>

              <path d="M160,130 C183,130 183,170 205,170" data-line="discord" class="flow-line" stroke="url(#flowGradient)" stroke-width="2" fill="none"></path>
              <circle r="4" data-line="discord" class="flow-dot fill-brand-500" style="offset-path: path('M160,130 C183,130 183,170 205,170');"></circle>

              <path d="M160,210 C183,210 183,170 205,170" data-line="music" class="flow-line" stroke="url(#flowGradient)" stroke-width="2" fill="none"></path>
              <circle r="4" data-line="music" class="flow-dot fill-brand-500" style="offset-path: path('M160,210 C183,210 183,170 205,170');"></circle>

              <path d="M160,290 C183,290 183,170 205,170" data-line="mic" class="flow-line" stroke="url(#flowGradient)" stroke-width="2" fill="none"></path>
              <circle r="4" data-line="mic" class="flow-dot fill-brand-500" style="offset-path: path('M160,290 C183,290 183,170 205,170');"></circle>

              <path d="M335,170 L380,170" data-line="mix" class="flow-line" stroke="url(#flowGradient)" stroke-width="2.5" fill="none"></path>
              <circle r="4" data-line="mix" class="flow-dot fill-brand-600" style="offset-path: path('M335,170 L380,170');"></circle>

              <path d="M510,170 L555,170" data-line="out" class="flow-line flow-line-out" stroke="url(#flowGradient)" stroke-width="3" fill="none"></path>
              <circle r="4.5" data-line="out" class="flow-dot fill-brand-700" style="offset-path: path('M510,170 L555,170');"></circle>

              <g data-node="game" class="flow-node">
                <rect x="20" y="28" width="140" height="44" rx="10" fill="white" fill-opacity="0.65" stroke="url(#flowGradient)" stroke-width="1.25" class="node-glass"></rect>
                <circle cx="40" cy="50" r="5" class="status-dot fill-brand-500"></circle>
                <text x="54" y="55" class="fill-ink text-[14px] font-semibold">Game</text>
                <text x="150" y="54" text-anchor="end" class="label-on fill-success text-[10px] font-bold tracking-wide">ON</text>
                <text x="150" y="54" text-anchor="end" class="label-off fill-ink-muted text-[10px] font-bold tracking-wide">OFF</text>
              </g>

              <g data-node="discord" class="flow-node">
                <rect x="20" y="108" width="140" height="44" rx="10" fill="white" fill-opacity="0.65" stroke="url(#flowGradient)" stroke-width="1.25" class="node-glass"></rect>
                <circle cx="40" cy="130" r="5" class="status-dot fill-brand-600"></circle>
                <text x="54" y="135" class="fill-ink text-[14px] font-semibold">Discord</text>
                <text x="150" y="134" text-anchor="end" class="label-on fill-success text-[10px] font-bold tracking-wide">ON</text>
                <text x="150" y="134" text-anchor="end" class="label-off fill-ink-muted text-[10px] font-bold tracking-wide">OFF</text>
              </g>

              <g data-node="music" class="flow-node">
                <rect x="20" y="188" width="140" height="44" rx="10" fill="white" fill-opacity="0.65" stroke="url(#flowGradient)" stroke-width="1.25" class="node-glass"></rect>
                <circle cx="40" cy="210" r="5" class="status-dot fill-brand-400"></circle>
                <text x="54" y="215" class="fill-ink text-[14px] font-semibold">Music</text>
                <text x="150" y="214" text-anchor="end" class="label-on fill-success text-[10px] font-bold tracking-wide">ON</text>
                <text x="150" y="214" text-anchor="end" class="label-off fill-ink-muted text-[10px] font-bold tracking-wide">OFF</text>
              </g>

              <g data-node="mic" class="flow-node">
                <rect x="20" y="268" width="140" height="44" rx="10" fill="white" fill-opacity="0.65" stroke="url(#flowGradient)" stroke-width="1.25" class="node-glass"></rect>
                <circle cx="40" cy="290" r="5" class="status-dot fill-success"></circle>
                <text x="54" y="295" class="fill-ink text-[14px] font-semibold">Mic</text>
                <text x="150" y="294" text-anchor="end" class="label-on fill-success text-[10px] font-bold tracking-wide">ON</text>
                <text x="150" y="294" text-anchor="end" class="label-off fill-ink-muted text-[10px] font-bold tracking-wide">OFF</text>
              </g>

              <rect x="205" y="138" width="130" height="64" rx="14" class="fill-brand-600 hub-core"></rect>
              <text x="270" y="176" text-anchor="middle" class="fill-white text-[16px] font-bold">RMDex</text>

              <rect x="380" y="138" width="130" height="64" rx="14" fill="white" fill-opacity="0.65" stroke="url(#flowGradient)" stroke-width="1.25" class="node-glass"></rect>
              <text x="445" y="176" text-anchor="middle" class="fill-ink text-[14px] font-semibold">Capture Card</text>

              <rect x="555" y="138" width="130" height="64" rx="14" fill="white" fill-opacity="0.65" stroke="url(#flowGradient)" stroke-width="1.25" class="node-glass"></rect>
              <text x="620" y="176" text-anchor="middle" class="fill-ink text-[14px] font-semibold">Stream Apps</text>
            </svg>
            <script>
              const flowNodes = ["game", "discord", "music", "mic"];
              if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                let index = 0;
                const turnOff = (name) => {
                  document
                    .querySelectorAll(`[data-node="${name}"], [data-line="${name}"]`)
                    .forEach((el) => el.classList.add("is-off"));
                };
                const turnOn = (name) => {
                  document
                    .querySelectorAll(`[data-node="${name}"], [data-line="${name}"]`)
                    .forEach((el) => el.classList.remove("is-off"));
                };
                const cycle = () => {
                  const name = flowNodes[index % flowNodes.length];
                  index++;
                  turnOff(name);
                  setTimeout(() => turnOn(name), 1700);
                };
                setTimeout(() => {
                  cycle();
                  setInterval(cycle, 3400);
                }, 1800);
              }
            </script>
          </div>
        </div>
      </section>

      <section class="border-y border-line px-6 py-14">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 sm:grid-cols-3">
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-600/10 text-brand-600">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4.5 w-4.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-ink">Per-app volume</h3>
              <p class="mt-0.5 text-sm text-ink-muted">Balance game, chat, and music independently.</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-600/10 text-brand-600">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4.5 w-4.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3zM19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-ink">Noise suppression</h3>
              <p class="mt-0.5 text-sm text-ink-muted">Removes fan hum and room noise from your mic.</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-600/10 text-brand-600">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4.5 w-4.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-ink">100% offline</h3>
              <p class="mt-0.5 text-sm text-ink-muted">No telemetry, no accounts, no network calls.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="download" class="px-6 py-20">
        <div class="mx-auto max-w-3xl">
          <div class="gradient-brand rounded-3xl p-6 text-center sm:p-14">
            <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Ready for your gaming PC</h2>
            <p class="mt-3 text-white/80">Windows 10, 64-bit · Free &amp; open source</p>
            <a
              href="https://apps.microsoft.com/detail/9n8qxcglxcqw?hl=en-US&gl=AE"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-brand-700 shadow-lg transition hover:bg-white/90"
              >Get it from Microsoft Store</a
            >
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-line px-6 py-10">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 sm:flex-row">
        <div class="flex items-center gap-2.5">
          <img src="/logo.png" alt="RMDex logo" class="h-7 w-7 rounded-lg" />
          <div class="text-sm text-ink-muted">
            <span class="font-bold text-ink">RMDex</span>
            <span class="mx-1">·</span>
            <span>© 2026 <a href="https://rishvan.com" target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">Rishvan</a> · MIT</span>
          </div>
        </div>
        <div class="flex items-center gap-6 text-sm font-medium text-ink-muted">
          <a href="https://github.com/Rishvan/RMDex" target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">GitHub</a>
          <a href="https://apps.microsoft.com/detail/9n8qxcglxcqw?hl=en-US&gl=AE" target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">Microsoft Store</a>
          <a href="https://buymeacoffee.com/rishvanrv7h" target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">Buy me a coffee</a>
        </div>
      </div>
    </footer>

    <a
      href="https://buymeacoffee.com/rishvanrv7h"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Buy me a coffee"
      title="Buy me a coffee"
      class="fixed right-4 bottom-4 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 text-white shadow-lg shadow-brand-600/30 transition hover:scale-105 hover:bg-brand-700 sm:right-6 sm:bottom-6 sm:h-14 sm:w-14"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 9h13v5a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V9Z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 10.5h1.5a2.5 2.5 0 0 1 0 5H16"></path>
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 6c0-1 1-1 1-2s-1-1-1-2M11 6c0-1 1-1 1-2s-1-1-1-2"></path>
      </svg>
    </a>
  </body>
</html>
